# ─────────────────────────────────────────────────────────────
# Travel Agent AI — variables d'environnement (copier en .env)
# Ne JAMAIS committer .env : il est ignoré par git.
# Toutes les clés restent côté serveur (aucune n'est préfixée NEXT_PUBLIC_).
# ─────────────────────────────────────────────────────────────

# Base de données (optionnelle : sans elle, stockage en mémoire)
DATABASE_URL="postgresql://travel:travel@localhost:5432/travel_agent"

# Cache Redis (optionnel : sans lui, cache mémoire du processus)
REDIS_URL=""

# LLM — compréhension du langage naturel (optionnel : sans clé, analyseur local)
# LLM_PROVIDER = auto | anthropic | openai | none
LLM_PROVIDER="auto"
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5-5"
OPENAI_API_KEY=""
OPENAI_MODEL=""

# ── Sources de transport ─────────────────────────────────────
# Données de démonstration : fallback = uniquement là où aucune donnée réelle n'existe ;
# off = jamais ; all = toujours (développement).
MOCK_POLICY="fallback"

# Open data GTFS (FlixBus, TIB Majorque) : `npm run gtfs:sync` remplit ce dossier.
GTFS_DIR="data/gtfs"

# API SNCF (Navitia) — token gratuit sur https://numerique.sncf.com/startup/api/
SNCF_API_TOKEN=""

# Duffel (vols) — un jeton duffel_test_… donne des offres FICTIVES (affichées comme démonstration)
DUFFEL_ACCESS_TOKEN=""

# Transitous (MOTIS) — désactivé tant que l'usage n'est pas convenu avec l'équipe Transitous.
# Le contact (e-mail ou URL) est envoyé dans le User-Agent, comme l'exige leur politique.
TRANSITOUS_ENABLED="false"
TRANSITOUS_CONTACT=""

# Réservés (adapters à écrire à réception des accès)
BLABLACAR_API_KEY=""
GOOGLE_MAPS_API_KEY=""

# ── Services transverses ─────────────────────────────────────
# Géocodage Nominatim (OpenStreetMap) : ≤ 1 requête/s, cache 30 jours, User-Agent identifiant.
NOMINATIM_ENABLED="true"
NOMINATIM_CONTACT_EMAIL=""
NOMINATIM_USER_AGENT=""

# Taux de change de référence BCE (gratuits). false = aucune conversion.
ENABLE_ECB_RATES="true"

# BrowserProviders — désactivés par défaut (voir docs/PROVIDER_ACCESS_STUDY.md)
# Le profil de navigateur doit être HORS du dépôt. Aucun mot de passe, cookie ou token ici.
BROWSER_PROFILE_DIR=""

# Divers
USER_TIMEZONE="Europe/Paris"
RATE_LIMIT_PER_MINUTE="30"
LOG_LEVEL="info"
